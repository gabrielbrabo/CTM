# Copie este arquivo para .env e preencha os valores
NODE_ENV=development
PORT=4000

# String de conexao do MongoDB Atlas (crie um banco chamado ctm)
MONGO_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/ctm?retryWrites=true&w=majority

# Segredos dos tokens (use textos longos e aleatorios, diferentes entre si)
JWT_SECRET=troque-este-segredo-de-acesso
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh

# Endereco do front (CORS e cookie)
CLIENT_URL=http://localhost:5173

# Usado pelo "npm run seed" para criar o superadmin da plataforma (GADZ)
SEED_ADMIN_NOME=Administrador GADZ
SEED_ADMIN_EMAIL=admin@gadz.com.br
SEED_ADMIN_SENHA=troque-esta-senha

# Anexos: sem S3_BUCKET os arquivos ficam na pasta server/uploads (bom para desenvolvimento)
S3_BUCKET=
S3_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ANEXO_MAX_MB=20
